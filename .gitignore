# ============================================================
# .gitignore recomendado para mortalidad-causa-especifica
# Estrategia:
# - excluir por defecto datos derivados, outputs y datos sensibles
# - permitir explícitamente insumos públicos/versionables
# - proteger SINADEF individual y cualquier derivado sensible
# ============================================================

# ============================================================
# 1. DATOS DERIVADOS Y OUTPUTS
# ============================================================
/data/final/
/data/derived/
/data/_catalog/
/outputs/

# ============================================================
# 2. DATA RAW: excluir por defecto y reabrir solo lo público
# ============================================================
/data/raw/**
!/data/raw/
!/data/raw/cause_mapping/
!/data/raw/cause_mapping/**
!/data/raw/redistribution_rules/
!/data/raw/redistribution_rules/**
/data/raw/sinadef/
/data/raw/sinadef/**

# ============================================================
# 3. ARCHIVOS TABULARES Y SERIALIZADOS
# ============================================================
*.csv
*.tsv
*.xlsx
*.xls
*.ods
*.parquet
*.feather
*.fst
*.rds
*.rda
*.RData
*.sqlite
*.db

# ============================================================
# 4. JSON / GEOJSON / OTROS DERIVADOS
# ============================================================
*.json
*.geojson
*.ndjson

# ============================================================
# 5. REPORTES RENDERIZADOS Y ARTEFACTOS DE QUARTO
# ============================================================
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.pptm
*.html
*_files/
.quarto/

# ============================================================
# 6. LOGS, TEMPORALES Y RESPALDOS
# ============================================================
*.log
*.tmp
*.temp
*.bak
*.out
*.err
*.aux
*.toc
*.lof
*.lot
*.gz
*.zip
*.7z

# ============================================================
# 7. R / RSTUDIO
# ============================================================
.Rhistory
.RData
.Ruserdata
.Rproj.user/
/.Rproj.user/

# ============================================================
# 8. PYTHON / JUPYTER / SISTEMA
# ============================================================
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# ============================================================
# 9. EXCEPCIONES IMPORTANTES: CÓDIGO Y DOCUMENTACIÓN FUENTE
# ============================================================
!*.R
!*.qmd
!*.md
!*.txt
!*.yml
!*.yaml
!*.css
!*.scss
!*.js
!*.sql
!*.sh
!*.bat
!*.ps1
!*.gitignore
!*.Rproj
!LICENSE

# ============================================================
# 10. CONFIGURACIÓN DEL PROYECTO
# ============================================================
!/config/
!/config/*.yml
!/config/*.yaml
!/config/*.R
!/config/*.csv
!/config/*.txt

# ============================================================
# 11. RAW PÚBLICOS ESPECÍFICOS VERSIONABLES
# ============================================================
!/data/raw/cause_mapping/*.xlsx
!/data/raw/cause_mapping/*.xls
!/data/raw/cause_mapping/*.csv
!/data/raw/redistribution_rules/*.xlsx
!/data/raw/redistribution_rules/*.xls
!/data/raw/redistribution_rules/*.csv

# ============================================================
# 12. INFRAESTRUCTURA REPRODUCIBLE
# ============================================================
!/renv.lock
!/.Rprofile
!/renv/
/renv/library/
/renv/staging/
!/renv/activate.R
!/renv/settings.json

# ============================================================
# 13. ARCHIVOS ESTRUCTURALES DEL PROYECTO
# ============================================================
!tree_project.txt
!Estructura-del-proyecto-actualizada.txt
!arbol-estructura.R
!README.qmd
!README.md
!docs/server_deployment_manual.pdf
!docs/quickstart_first_use.pdf

# ============================================================
# 14. MAESTROS / DICCIONARIOS VERSIONABLES
# ============================================================
!config/maestro_age_simple.csv
!config/maestro_external_inputs.csv
!data/raw/cause_mapping/codificacion-causas-enfermedad.xlsx
!data/raw/redistribution_rules/codigos-redistribucion-muerte.xlsx
!data/raw/redistribution_rules/patch_targets_redistribucion_excluir_yll.csv

# ============================================================
# 15. REPORTES GENERADOS Y PORTAL QC
#    Mantener solo plantillas y fuentes estructurales.
# ============================================================
/reports/all_causes_validation_excels/
/reports/all_causes_validation_report/
/reports/all_causes_word_report/
/reports/final_word_report/
/reports/qc_completeness_validation/
/reports/qc_pipeline_encyclopedia/index.html
/reports/qc_pipeline_encyclopedia/publish_guide.html
/reports/qc_pipeline_encyclopedia/modules/
/reports/qc_pipeline_encyclopedia/pdf/
/reports/methodological_adjustment_report/pdf/
/reports/methodological_adjustment_report/tables/
/reports/methodological_adjustment_report/methodological_adjustment_report.pdf

!/reports/
!/reports/qc_pipeline_encyclopedia/
!/reports/qc_pipeline_encyclopedia/assets/
!/reports/qc_pipeline_encyclopedia/assets/**
!/reports/qc_pipeline_encyclopedia/templates/
!/reports/qc_pipeline_encyclopedia/templates/**
!/reports/methodological_adjustment_report/
!/reports/methodological_adjustment_report/*.qmd
!/reports/methodological_adjustment_report/*.md
!/reports/methodological_adjustment_report/*.R

# ============================================================
# 16. RECORDATORIO
# ============================================================
# Antes de hacer git add ., confirma con:
#   git status --ignored
# y revisa especialmente que NO entren:
# - data/raw/sinadef/
# - data/final/
# - data/derived/
# - outputs/
# - reportes renderizados
# - cualquier csv/parquet derivado sensible
# ============================================================
